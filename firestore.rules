rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
        data.email is string &&
        data.displayName is string;
    }

    function isValidTask(data) {
      return data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200 &&
        data.isCompleted is bool;
    }

    function isValidMemory(data) {
      return data.userId == request.auth.uid &&
        data.content is string &&
        data.content.size() > 0;
    }

    function isValidLlmUsage(newData) {
      // Central Gemini key: per-user daily LLM usage counter.
      // Exactly one bucket increments by exactly 1 per Gemini turn;
      // the other bucket is unchanged. Hard caps (freeUsed <= 5,
      // bonusUsed <= 3) must match the Remote Config keys
      // chat_free_turns_per_day and ad_rewarded_max_turns_per_day.
      // `resource` is null on create (both buckets start at 0).
      return newData.keys().hasOnly(['freeUsed', 'bonusUsed', 'updatedAt'])
        && newData.freeUsed is int && newData.freeUsed >= 0 && newData.freeUsed <= 5
        && newData.bonusUsed is int && newData.bonusUsed >= 0 && newData.bonusUsed <= 3
        && newData.updatedAt is timestamp
        && (
          (resource == null && newData.freeUsed + newData.bonusUsed == 1)
          || (resource != null
            && resource.data.freeUsed is int && resource.data.bonusUsed is int
            && newData.freeUsed >= resource.data.freeUsed
            && newData.bonusUsed >= resource.data.bonusUsed
            && (newData.freeUsed - resource.data.freeUsed)
            + (newData.bonusUsed - resource.data.bonusUsed) == 1)
        );
    }

    function isValidEvent(data) {
      return data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
      }

      match /memories/{memoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(request.resource.data);
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEvent(request.resource.data);
      }

      // Central Gemini key: per-user daily LLM usage counter
      // (users/{uid}/llmUsage/{yyyy-MM-dd}). Only the owning uid may
      // read or write it; deletes are never allowed.
      match /llmUsage/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidLlmUsage(request.resource.data);
        allow delete: if false;
      }
    }

    // ---- Groups (Phase 1) ----
    match /groups/{gid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.creatorUid == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.creatorUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    }

    match /groups/{gid}/members/{uid} {
      allow read: if request.auth != null && (
        uid == request.auth.uid ||
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)));
      // B3: membership requires proof of the join code. The member-doc
      // write must carry the code, verified against the groupCodes doc
      // (groupCodes/{code}.groupId == gid). Both joinGroup() and
      // createGroup() (creator's first member write) include "code" in
      // the payload; a write without a matching code is denied, so the
      // code can no longer be bypassed by writing the member doc
      // directly. A missing code doc (wrong code) denies via the get().
      allow create: if request.auth != null && uid == request.auth.uid
        && 'code' in request.resource.data
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/groupCodes/$(request.resource.data.code)).data.groupId == gid;
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    match /groups/{gid}/items/{itemId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid;
    }

    // B3: get only — `allow read` also granted `list`, letting any
    // signed-in user enumerate every join code. Nothing in the app
    // lists this collection (join does a single doc get).
    match /groupCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.creatorUid == request.auth.uid;
    }

    match /users/{uid}/groupMemberships/{gid} {
      allow read, write: if request.auth != null && uid == request.auth.uid;
      allow delete: if request.auth != null && (uid == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
    }
  }
}
