rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
        data.email is string &&
        data.displayName is string;
    }

    function isValidTask(data) {
      return data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200 &&
        data.isCompleted is bool;
    }

    function isValidMemory(data) {
      return data.userId == request.auth.uid &&
        data.content is string &&
        data.content.size() > 0;
    }

    function isValidLlmUsage(newData) {
      // Central Gemini key: per-user daily LLM usage counter.
      // Exactly one bucket increments by exactly 1 per Gemini turn;
      // the other bucket is unchanged. Hard caps (freeUsed <= 5,
      // bonusUsed <= 3) must match the Remote Config keys
      // chat_free_turns_per_day and ad_rewarded_max_turns_per_day.
      // `resource` is null on create (both buckets start at 0).
      return newData.keys().hasOnly(['freeUsed', 'bonusUsed', 'updatedAt'])
        && newData.freeUsed is int && newData.freeUsed >= 0 && newData.freeUsed <= 5
        && newData.bonusUsed is int && newData.bonusUsed >= 0 && newData.bonusUsed <= 3
        && newData.updatedAt is timestamp
        && (
          (resource == null && newData.freeUsed + newData.bonusUsed == 1)
          || (resource != null
            && resource.data.freeUsed is int && resource.data.bonusUsed is int
            && newData.freeUsed >= resource.data.freeUsed
            && newData.bonusUsed >= resource.data.bonusUsed
            && (newData.freeUsed - resource.data.freeUsed)
            + (newData.bonusUsed - resource.data.bonusUsed) == 1)
        );
    }

    function isValidEvent(data) {
      return data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 200;
    }

    function isGroupMember(gid) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function isCompletionOnlyUpdate() {
      // Sprint 5-0 (feature 31) + 5-2 (offline toggle, Q7=(a)): a member
      // may update an item doc ONLY to toggle their own completion. The
      // changed keys must be exactly completedBy + completedCount (+ an
      // updatedAt server-timestamp bump, so the poll query sees the
      // change — the toggle writes it, never any other field); the
      // count must equal the array size; and the only UID added or
      // removed must be the caller's own. A doc written before S5-0
      // has no completedBy — .get(..., []) treats it as empty.
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['completedBy', 'completedCount', 'updatedAt'])
        && request.resource.data.completedBy is list
        && request.resource.data.completedCount is int
        && request.resource.data.completedCount == request.resource.data.completedBy.size()
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.completedBy.toSet()
            .difference(resource.data.get('completedBy', []).toSet())
            .hasOnly([request.auth.uid])
        && resource.data.get('completedBy', []).toSet()
            .difference(request.resource.data.completedBy.toSet())
            .hasOnly([request.auth.uid]);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
      }

      match /memories/{memoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(request.resource.data);
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidEvent(request.resource.data);
      }

      // Central Gemini key: per-user daily LLM usage counter
      // (users/{uid}/llmUsage/{yyyy-MM-dd}). Only the owning uid may
      // read or write it; deletes are never allowed.
      match /llmUsage/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidLlmUsage(request.resource.data);
        allow delete: if false;
      }
    }

    // ---- Groups (Phase 1) ----
    match /groups/{gid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.creatorUid == request.auth.uid;
      // Creator may update anything; a member may update ONLY
      // lastUpdatedAt (kept from Sprint 5-0 — a narrow, harmless
      // allowance; no current member write touches the group doc:
      // the completion toggle bumps only the item doc's updatedAt).
      // A member changing any other group field is denied.
      allow update: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         (isGroupMember(gid) && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['lastUpdatedAt'])));
      allow delete: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    }

    match /groups/{gid}/members/{uid} {
      allow read: if request.auth != null && (
        uid == request.auth.uid ||
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)));
      // B3: membership requires proof of the join code. The member-doc
      // write must carry the code, verified against the groupCodes doc
      // (groupCodes/{code}.groupId == gid). Both joinGroup() and
      // createGroup() (creator's first member write) include "code" in
      // the payload; a write without a matching code is denied, so the
      // code can no longer be bypassed by writing the member doc
      // directly. A missing code doc (wrong code) denies via the get().
      allow create: if request.auth != null && uid == request.auth.uid
        && 'code' in request.resource.data
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/groupCodes/$(request.resource.data.code)).data.groupId == gid;
      allow delete: if request.auth != null && (uid == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
      // Step 2-2 (Profile Edit): a member may update ONLY their own
      // displayName — no other member-doc field may change, and nobody
      // may update another member's doc. The displayName must stay a
      // string; the app rejects a blank name before writing.
      allow update: if request.auth != null && uid == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string;
    }

    match /groups/{gid}/items/{itemId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
      // Sprint 5-2 (Q3=(b)): ONLY the creator may create an item — the
      // S5-0 widening (any member could create) is reverted. The
      // creator keeps full update/delete; a member may update ONLY
      // their own completion (isCompletionOnlyUpdate), never another
      // field. The repository enforces the same check locally.
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if request.auth != null &&
        (get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid ||
         (isGroupMember(gid) && isCompletionOnlyUpdate()));
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid;
    }

    // Sprint 5-0 (feature 32): text-only admin notices. Only the
    // creator may send or delete one; members may read them. No update
    // — a notice is never edited, only replaced by a new one.
    match /groups/{gid}/notices/{noticeId} {
      allow read: if request.auth != null && isGroupMember(gid);
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid;
    }

    // Shared list (spec s7-shared-list-scope-spec, Q1=(a), micro-task 1):
    // any group member may create a list, add items, flip done,
    // (re)assign and comment — deliberately unlike group tasks
    // (Sprint 5-2 Q3=(b), creator-only). Deletes stay with the creator
    // of the thing or the group creator. A comment is never edited,
    // only deleted (same as notices).
    match /groups/{gid}/sharedLists/{listId} {
      allow read: if request.auth != null && isGroupMember(gid);
      allow create: if isGroupMember(gid) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      // Rename only — the only list field anyone ever updates.
      allow update: if request.auth != null &&
        (resource.data.createdByUid == request.auth.uid ||
         get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if request.auth != null &&
        (resource.data.createdByUid == request.auth.uid ||
         get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
    }

    match /groups/{gid}/sharedLists/{listId}/items/{itemId} {
      allow read: if request.auth != null && isGroupMember(gid);
      allow create: if isGroupMember(gid) &&
        request.resource.data.addedByUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0;
      // Any member may flip done / (re)assign — the changed keys must
      // be exactly the done/assignee set (+ an updatedAt bump, so the
      // poll query sees the change). Editing the text itself needs the
      // adder or the group creator. No update may touch anything
      // outside the writable set (addedByUid / createdAt are immutable).
      allow update: if request.auth != null && isGroupMember(gid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text', 'done', 'doneByUid', 'assigneeUid', 'assigneeName', 'updatedAt']) &&
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['done', 'doneByUid', 'assigneeUid', 'assigneeName', 'updatedAt'])
         || resource.data.addedByUid == request.auth.uid
         || get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.addedByUid == request.auth.uid ||
         get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
    }

    match /groups/{gid}/sharedLists/{listId}/items/{itemId}/comments/{commentId} {
      allow read: if request.auth != null && isGroupMember(gid);
      allow create: if isGroupMember(gid) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0;
      allow update: if false;
      allow delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid ||
         get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
    }

    // Sprint 5-5 (feature 36): activity history. Members read it;
    // entries are written only by the member who did the action
    // (actorUid == auth.uid) with a type from the fixed set —
    // creator-only actions additionally require the actor to be the
    // creator, mirroring the action rules (a member cannot record a
    // task creation or an assignment). No update — history is
    // append-only; only the creator deletes (the S5-4 cascade).
    function isValidActivity(data) {
      return data.actorUid == request.auth.uid &&
        data.type is string &&
        data.type in ['group_created', 'member_joined', 'member_left',
          'task_created', 'schedule_created', 'task_edited',
          'task_deleted', 'schedule_deleted', 'task_completed',
          'task_reopened', 'task_assigned', 'task_unassigned',
          'notice_sent',
          // Shared list, micro-task 1 (Q1=(a)): every member-doable
          // list action has an activity type.
          'list_created', 'list_item_added', 'list_item_completed',
          'list_item_reopened', 'list_item_assigned',
          'list_item_commented', 'list_deleted'] &&
        data.createdAt is timestamp;
    }

    match /groups/{gid}/activity/{activityId} {
      allow read: if request.auth != null && isGroupMember(gid);
      allow create: if request.auth != null && isGroupMember(gid) &&
        isValidActivity(request.resource.data) &&
        (request.resource.data.type in ['member_joined', 'member_left',
           'task_completed', 'task_reopened',
           // Shared list: a member records only their own list
           // actions (isValidActivity already pins actorUid). The
           // list_deleted entry is in the same set because the list
           // creator — not only the group creator — may delete a
           // list; the delete itself is gated by the sharedLists
           // rule, the activity entry is only informational.
           'list_created', 'list_item_added', 'list_item_completed',
           'list_item_reopened', 'list_item_assigned',
           'list_item_commented', 'list_deleted'] ||
         get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
      allow update: if false;
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid;
    }

    // B3: get only — `allow read` also granted `list`, letting any
    // signed-in user enumerate every join code. Nothing in the app
    // lists this collection (join does a single doc get).
    match /groupCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.creatorUid == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.creatorUid == request.auth.uid;
    }

    match /users/{uid}/groupMemberships/{gid} {
      allow read, write: if request.auth != null && uid == request.auth.uid;
      allow delete: if request.auth != null && (uid == request.auth.uid ||
        get(/databases/$(database)/documents/groups/$(gid)).data.creatorUid == request.auth.uid);
    }
  }
}
