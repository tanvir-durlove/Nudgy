<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".NudgyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- AdMob application id (real Nudgy app, AdMob account
             nextgentoolbd@gmail.com, publisher pub-7794111343358988).
             The App ID is public-by-design; ad unit IDs stay in Remote
             Config only and must never be hardcoded here. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7794111343358988~1839203920" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nudgy.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sprint 2-3 — share-to-task (Feature 12): another app
                 sharing text lands here; MainActivity hands the intent
                 to ShareIntentViewModel, which opens the prefilled
                 task sheet. Text only (Q6(a)) — no image/file type. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- App Links: group-join deep link. Verification (autoVerify)
                 needs the matching assetlinks.json on tanvir-durlove.github.io. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="tanvir-durlove.github.io"
                    android:pathPrefix="/nudgy/join"
                    android:scheme="https" />
            </intent-filter>
            <!-- Sprint 2-4 — date link (App Link): tapping a
                 /nudgy/date link opens the Calendar on that date (and
                 highlights the slot when t is present). Same host as
                 the join link — no new assetlinks entry needed; the
                 file already lists both fingerprints (upload + app-signing).
                 Verified pre-merge via the Digital Asset Links API
                 (linked: true for both fingerprints). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="tanvir-durlove.github.io"
                    android:pathPrefix="/nudgy/date"
                    android:scheme="https" />
            </intent-filter>
            <!-- Sprint 2-4 — Gmail-style "create event"
                 (ACTION_INSERT): opens the add-event dialog prefilled
                 with the intent's title / times / location. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Sprint 6-5 (step 3a) — the Today widget (Glance): one
             widget, today's planned tasks, read from Room. Exported:
             the system delivers APPWIDGET_UPDATE broadcasts to it. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Sprint 1-4 — FileProvider for attachment opening (Feature 10).
             Files live in app-private storage (files/attachments/), so
             another app can only open one through a content Uri with a
             one-shot read grant. Not exported; the authority matches the
             string used in TasksScreen. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.nextgentool.nudgy.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
