<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+ cloud backup + device transfer).
   Shared preferences are excluded: they hold credential material
   (the user's Gemini API key, Firebase auth state) that must never
   leave the device through a backup or transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
