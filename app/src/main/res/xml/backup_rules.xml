<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules (pre-API 31 full backup).
   Shared preferences are excluded: they hold credential material
   (the user's Gemini API key, Firebase auth state) that must never
   ride along in a cloud backup. Tasks/events data is covered by
   Firestore sync for signed-in users.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
