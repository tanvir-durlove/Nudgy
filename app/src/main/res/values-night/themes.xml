<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Night variant of the launch splash (androidx core-splashscreen):
         same icon, animation and post-splash theme as values/themes.xml —
         the background stays cream (#F4EFE4) here too, so the splash is
         always light even in dark mode. -->
    <style name="Theme.Nudgy.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4EFE4</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
