<?xml version="1.0" encoding="utf-8"?>
<!--
  R8 shrinkResources removes resources it cannot see a static reference to.
  AuthManager reads default_web_client_id via resources.getIdentifier (no
  static R.string reference on purpose, so builds without google-services.json
  still compile) — the shrinker stripped the google-services-generated string
  and Google Sign-In failed with "client ID not found" (PR #33). Keep it.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
